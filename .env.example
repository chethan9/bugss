# Supabase (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: canonical site URL for auth redirects (falls back to Vercel URL on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub access uses Personal Access Tokens stored per profile in Supabase (github_connections).

# Supabase service role — optional; for server-side admin scripts only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
