# Supabase (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: canonical site URL for auth redirects (falls back to Vercel URL on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub OAuth (server-only; create a GitHub OAuth App)
# Callback URL must match: {origin}/api/github/oauth/callback
# e.g. http://localhost:3000/api/github/oauth/callback and your production URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=
# Optional full callback URL override (otherwise derived from NEXT_PUBLIC_SITE_URL or VERCEL_URL)
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain.com/api/github/oauth/callback

# Supabase service role — only for OAuth callback to write github_connections (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
